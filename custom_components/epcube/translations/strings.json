{
  "config": {
    "step": {
      "user": {
        "title": "EP Cube",
        "description": "How do you want to sign in?",
        "menu_options": {
          "credentials": "Email and password (recommended: the token renews automatically)",
          "token": "Paste a token"
        }
      },
      "credentials": {
        "title": "EP Cube account",
        "description": "Use the same email and password as the EP Cube app. Home Assistant signs in on its own (solving the login captcha) and renews the token when it expires. The password is stored in Home Assistant's configuration.",
        "data": {
          "username": "Email",
          "password": "Password",
          "region": "Region"
        }
      },
      "token": {
        "data": {
          "token": "EPCUBE Token",
          "region": "Region (must match the one used to generate the token)"
        },
        "description": "Paste the token generated for the SAME region you select here. A token created for another region is rejected by the server. A pasted token is not renewed automatically."
      },
      "reauth_confirm": {
        "title": "Sign in to EP Cube again",
        "description": "The EP Cube token is no longer valid. Enter the app's email and password: from now on the token will be renewed automatically.",
        "data": {
          "username": "Email",
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_token": "Token rejected by the server. It is expired, or it was generated for a different region — regenerate it choosing the same region you select here (US covers North America, including Canada).",
      "sn_not_found": "No device found for this account.",
      "forbidden": "Access denied by the server.",
      "server_error": "EP Cube server error. Try again later.",
      "http_error": "Unexpected response from the EP Cube server.",
      "timeout": "Timeout contacting the EP Cube server.",
      "connection_error": "Cannot reach the EP Cube server. Check Home Assistant's internet access.",
      "unknown_error": "Unknown error. Check the Home Assistant logs for details.",
      "invalid_auth": "Email or password rejected by the EP Cube server.",
      "captcha_failed": "The login captcha could not be solved. Try again in a moment.",
      "wrong_account": "This account does not own the configured EP Cube."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "reauth_successful": "Signed in again: the integration is reloading."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "username": "Email (to renew the token automatically)",
          "password": "Password (leave empty to keep the current one)",
          "token": "EPCUBE Token",
          "scan_interval": "Data update frequency",
          "scale_power": "Multiply power values (*1000)",
          "enable_total": "Enable all total sensors",
          "enable_annual": "Enable all annual sensors",
          "enable_monthly": "Enable all monthly sensors"
        },
        "description": "Fill in email and password to let the integration renew the token on its own."
      }
    },
    "error": {
      "invalid_auth": "Email or password rejected by the EP Cube server.",
      "captcha_failed": "The login captcha could not be solved. Try again in a moment.",
      "connection_error": "Cannot reach the EP Cube server. Check Home Assistant's internet access.",
      "unknown_error": "Unknown error. Check the Home Assistant logs for details.",
      "missing_username": "Enter the email together with the password."
    }
  },
